<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWinUI>true</UseWinUI>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsSdkPackageVersion>10.0.26100.38</WindowsSdkPackageVersion>
        <RootNamespace>MercuryLibrary</RootNamespace>
        <AssemblyName>MercuryLibrary</AssemblyName>

        <!-- NuGet Package Properties -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>MercuryLibrary</PackageId>
        <Version>1.0.15</Version>
        <Authors>Mercury Authors</Authors>
        <Description>A WinUI 3 component library for Mercury projects.</Description>
        <PackageProjectUrl>https://github.com/philb/MercuryLibrary</PackageProjectUrl>
        <RepositoryUrl>https://github.com/philb/MercuryLibrary</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>WinUI3;WindowsAppSDK;Mercury</PackageTags>
        <Copyright>Copyright © 2026</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003"/>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742"/>
        <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <!--
        WinUI 3 control libraries compile their XAML into a .pri resource file.
        The default NuGet pack does not include it, so consuming apps cannot resolve
        the embedded XAML at runtime (XamlParseException in InitializeComponent).
        Pack the generated MercuryLibrary.pri next to the dll in lib\<tfm>\ so the
        consuming app merges it into its own resources.pri at build time.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludePriInPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="IncludePriInPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).pri"
                                    Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
                <PackagePath>lib\net10.0-windows10.0.19041\</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

</Project>
