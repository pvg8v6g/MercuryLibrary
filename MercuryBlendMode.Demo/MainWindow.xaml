<Window x:Class="MercuryBlendMode.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MercuryBlendMode.Demo"
        xmlns:mbm="clr-namespace:MercuryBlendMode;assembly=MercuryBlendMode"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        Title="MercuryBlendMode Demo" Height="700" Width="1000"
        Background="#222">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!-- Game Canvas Area -->
        <Border BorderBrush="Black" BorderThickness="1" Margin="10" Background="White">
            <mbm:MercurySequentialCanvas x:Name="OuterCanvas" ClipToBounds="True" ItemsSource="{Binding CompositeCollection}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <mbm:MercurySequentialPanel Width="800" Height="600" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="mbm:MercuryCanvas.BlendMode" Value="{Binding BlendMode}" />
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        <Setter Property="Panel.ZIndex" Value="{Binding Z}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Name="SpriteImage" Source="{Binding ImagePath}" Stretch="None" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </mbm:MercurySequentialCanvas>
        </Border>

        <!-- Sidebar UI -->
        <StackPanel Grid.Column="1" Margin="10">
            <Button Content="Add Random Sprite" Command="{Binding AddSpriteCommand}" Margin="0,0,0,10" Padding="5"/>
            
            <TextBlock Text="Sprite List (Click to change mode)" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
            <ListBox ItemsSource="{Binding CompositeCollection}" Background="#333" Foreground="White" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <ComboBox ItemsSource="{Binding DataContext.AllBlendModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding BlendMode}" />
                            <Button Content="Remove" Command="{Binding DataContext.RemoveSpriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}" Margin="0,2,0,5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
