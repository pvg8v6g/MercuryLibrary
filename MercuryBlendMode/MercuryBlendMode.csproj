    <ItemGroup>
      <None Include="Shaders\*.hlsl" />
    </ItemGroup>

    <ItemGroup>
      <ClCompile Include="Shaders\Difference.hlsl" />
      <ClCompile Include="Shaders\Exclusion.hlsl" />
    </ItemGroup>
</Project>
